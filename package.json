{
  "name": "weather-meteogram-card",
  "version": "0.1.0",
  "description": "DMI-style hourly weather meteogram card for Home Assistant (Apache ECharts).",
  "license": "MIT",
  "author": "Kristian Tryggestad",
  "repository": {
    "type": "git",
    "url": "https://github.com/ktryggestad/weather-meteogram-card"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "start": "concurrently --kill-others --names build,serve \"vite build --watch\" \"vite preview\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "custom-card-helpers": "^1.9.0",
    "echarts": "^5.5.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "browserslist": [
    "last 4 Chrome versions",
    "last 1 ChromeAndroid versions",
    "last 4 Edge versions",
    "last 4 Firefox versions",
    "Safari >= 17.6",
    "iOS >= 17.6"
  ]
}
